---
import BaseLayout from '../layouts/BaseLayout.astro';
// The map and dated list are self-contained blocks generated by the Techstars
// Belfast Ecosystem Hub, one per month, pasted in via scripts/stack-embeds.py.
// See the comment at the top of src/embeds/ecosystem-map.html for the routine.
// At build time this page lifts the hiring and news cards out of each block
// into their own sections (roles and news are not month-bound), strips those
// two filter chips from the map, and shows one month's map at a time.
import embed from '../embeds/ecosystem-map.html?raw';

const SUBMIT_EMAIL = 'techstarsbelfast@ormeaulabs.com';

const decode = (s) => s
    .replace(/&#8217;/g, '’').replace(/&#8216;/g, '‘').replace(/&#39;/g, "'")
    .replace(/&#8220;/g, '“').replace(/&#8221;/g, '”').replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#163;/g, '£');
const text = (html) => decode(html.replace(/<[^>]+>/g, '').trim());
const pick = (card, re) => { const m = card.match(re); return m ? text(m[1]) : ''; };
const href = (card) => { const m = card.match(/<a href="([^"]+)"/); return m ? decode(m[1]) : ''; };

// One block per month, in file order (current month first).
const blocks = embed.split(/(?=<!-- Techstars Belfast events map · )/).filter(b => b.includes('id="tsb-ev'));

const months = [];
const jobs = new Map();
const news = new Map();

for (const raw of blocks) {
    const label = (raw.match(/events map · ([A-Za-z]+ \d{4}) ·/) || [])[1] || 'This month';
    const id = (raw.match(/<div id="(tsb-ev[-\d]*)"/) || [])[1];
    if (!id) continue;

    let block = raw;
    const hStart = block.indexOf('<div class="tsb-x" data-t="hiring" hidden>');
    const nStart = block.indexOf('<div class="tsb-x" data-t="news" hidden>');
    const sStart = block.indexOf('<script>');
    if (nStart > -1 && sStart > nStart) {
        const from = hStart > -1 ? hStart : nStart;
        const removed = block.slice(from, sStart);
        const hiringPanel = hStart > -1 ? removed.slice(0, nStart - from) : '';
        const newsPanel = removed.slice(nStart - from).replace(/<\/div><\/div>\s*$/, '');
        for (const m of hiringPanel.matchAll(/<article class="card plain" data-type="hiring">([\s\S]*?)<\/article>/g)) {
            const c = m[1];
            const company = pick(c, /<h3>([\s\S]*?)<\/h3>/);
            if (!company) continue;
            // Later months are earlier in the file, so the first seen wins.
            if (!jobs.has(company.toLowerCase())) jobs.set(company.toLowerCase(), {
                company, roles: pick(c, /<div class="when">([\s\S]*?)<\/div>/),
                where: pick(c, /<div class="where">([\s\S]*?)<\/div>/),
                note: pick(c, /<p class="note">([\s\S]*?)<\/p>/), link: href(c), month: label,
            });
        }
        for (const m of newsPanel.matchAll(/<article class="card plain" data-type="news">([\s\S]*?)<\/article>/g)) {
            const c = m[1];
            const title = pick(c, /<h3>([\s\S]*?)<\/h3>/);
            if (!title) continue;
            if (!news.has(title.toLowerCase())) news.set(title.toLowerCase(), {
                title, note: pick(c, /<p class="note">([\s\S]*?)<\/p>/),
                source: pick(c, /<span class="src">([\s\S]*?)<\/span>/), link: href(c), month: label,
            });
        }
        block = block.slice(0, from) + '</div></div>\n' + block.slice(sStart);
    }
    // Drop the two chips and the hash routes that no longer have a panel.
    block = block
        .replace(/<button data-t="hiring"[^>]*>[\s\S]*?<\/button>/, '')
        .replace(/<button data-t="news"[^>]*>[\s\S]*?<\/button>/, '')
        .replace(/\|\|h==="hiring"\|\|h==="news"/g, '');
    months.push({ label, id, html: block });
}

const jobList = [...jobs.values()];
const newsList = [...news.values()];
---

<BaseLayout title="Ecosystem" description="What is on across the Northern Ireland start-up community: events and funding deadlines on a map, who is hiring, and the news. Updated monthly.">
    <section class="hero">
        <div class="wrap wrap--mid">
            <p class="eyebrow">Ecosystem</p>
            <h1>What's on,<br /><span class="accent">across Northern Ireland.</span></h1>
            <p class="lead hero-lead">
                Events and funding deadlines on the map, who is hiring, and the news from the start-up community. Updated at the start of every month.
            </p>
            <nav class="jump" aria-label="On this page">
                <a href="#whats-on">What's on</a>
                <a href="#hiring">Who's hiring</a>
                <a href="#news">News</a>
            </nav>
        </div>
    </section>

    <section id="whats-on" class="section--tight divide ecosystem">
        <div class="wrap">
            <div class="sec-head">
                <h2>What's on</h2>
                <p class="muted">Pick a month, then a town on the map, a week, or a filter. Funding deadlines sit alongside events.</p>
            </div>
            {months.length > 1 && (
                <div class="month-switch" role="group" aria-label="Choose a month">
                    {months.map(m => <button type="button" data-target={m.id} aria-pressed="false">{m.label}</button>)}
                </div>
            )}
            {months.map(m => <Fragment set:html={m.html} />)}
        </div>
    </section>

    <section id="hiring" class="section--tight divide hiring">
        <div class="wrap">
            <div class="sec-head">
                <h2>Who's hiring</h2>
                <p class="muted">Live roles at Northern Ireland start-ups and scale-ups. Not tied to a month: a role stays here until it closes.</p>
            </div>
            {jobList.length ? (
                <div class="role-grid">
                    {jobList.map(j => (
                        <article class="role">
                            <h3>{j.company}</h3>
                            {j.roles && <p class="roles">{j.roles}</p>}
                            {j.where && <p class="where">{j.where}</p>}
                            {j.note && <p class="muted note">{j.note}</p>}
                            {j.link && <a href={j.link} class="btn btn--sm" target="_blank" rel="noopener">See roles</a>}
                        </article>
                    ))}
                </div>
            ) : (
                <p class="muted">No roles listed right now. The next round lands with the monthly update.</p>
            )}
        </div>
    </section>

    <section id="news" class="section--tight divide newsroom">
        <div class="wrap">
            <div class="sec-head">
                <h2>News</h2>
                <p class="muted">What happened in the ecosystem this month and last.</p>
            </div>
            {newsList.length ? (
                <div class="news-list">
                    {newsList.map(n => (
                        <article class="news-item">
                            <h3>{n.link ? <a href={n.link} target="_blank" rel="noopener">{n.title}</a> : n.title}</h3>
                            {n.note && <p class="muted">{n.note}</p>}
                            <p class="src">{[n.source, n.month].filter(Boolean).join(' · ')}</p>
                        </article>
                    ))}
                </div>
            ) : (
                <p class="muted">No news listed right now.</p>
            )}
        </div>
    </section>

    <section class="section--tight divide submit">
        <div class="wrap">
            <p>Listed monthly by the Techstars Belfast community team. Running an event, opening a role, or have news from your company? <a href={`mailto:${SUBMIT_EMAIL}?subject=Ecosystem%20page`}>Send it to us</a> and it goes in the next update.</p>
        </div>
    </section>
</BaseLayout>

<script>
    const sw = document.querySelector('.month-switch');
    if (sw) {
        const buttons = [...sw.querySelectorAll('button')];
        const show = (id: string) => {
            buttons.forEach(b => {
                const on = b.dataset.target === id;
                b.setAttribute('aria-pressed', on ? 'true' : 'false');
                const block = document.getElementById(b.dataset.target || '');
                if (block) block.hidden = !on;
            });
        };
        const now = new Date().toLocaleString('en-GB', { month: 'long', year: 'numeric' });
        const current = buttons.find(b => b.textContent?.trim() === now) || buttons[0];
        show(current.dataset.target || '');
        buttons.forEach(b => b.addEventListener('click', () => show(b.dataset.target || '')));
    }
</script>

<style>
    .hero { padding: 5rem 0 3rem; }
    .hero h1 { margin-bottom: 1rem; }
    .accent { color: var(--accent); }
    .hero-lead { max-width: 56ch; }
    .jump { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.5rem; }
    .jump a { font-weight: 600; color: var(--accent); border-bottom: 2px solid var(--accent-soft); padding-bottom: 2px; }
    .sec-head { margin-bottom: 1.75rem; }
    .sec-head h2 { margin-bottom: 0.5rem; }
    .sec-head p { max-width: 60ch; }
    .ecosystem { background: #fff; }
    .month-switch { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0 0 1.75rem; }
    .month-switch button {
        font: inherit; font-size: 0.95rem; font-weight: 600; padding: 0.5rem 1.1rem;
        border-radius: 999px; border: 1.5px solid var(--line); background: #fff; color: #0d0d0d; cursor: pointer;
    }
    .month-switch button[aria-pressed="true"] { background: #0d0d0d; border-color: #0d0d0d; color: #fff; }
    .hiring { background: var(--bg-subtle); }
    .role-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
    .role { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .role h3 { margin: 0; font-size: 1.2rem; }
    .role .roles { margin: 0; font-weight: 500; }
    .role .where { margin: 0; font-size: 0.9rem; color: var(--accent); font-weight: 600; }
    .role .note { margin: 0; font-size: 0.95rem; flex: 1; }
    .role .btn { align-self: flex-start; margin-top: 0.5rem; }
    .newsroom { background: #fff; }
    .news-list { display: flex; flex-direction: column; }
    .news-item { padding: 1.4rem 0; border-top: 1px solid var(--line); }
    .news-item:last-child { border-bottom: 1px solid var(--line); }
    .news-item h3 { margin: 0 0 0.4rem; font-size: 1.15rem; }
    .news-item h3 a { color: inherit; }
    .news-item h3 a:hover { color: var(--accent); }
    .news-item p { margin: 0 0 0.4rem; max-width: 70ch; }
    .news-item .src { font-size: 0.85rem; color: #6b6b66; margin: 0; }
    .submit { background: var(--bg-subtle); }
    .submit p { max-width: 70ch; margin: 0; }
    .submit a { font-weight: 600; color: var(--accent); }
</style>
