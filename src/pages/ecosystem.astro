---
import BaseLayout from '../layouts/BaseLayout.astro';
// The map and list are self-contained blocks generated by the Techstars
// Belfast Ecosystem Hub, one per month, pasted in via
// scripts/stack-embeds.py. See the comment at the top of
// src/embeds/ecosystem-map.html for the routine. The page shows one month
// at a time; the switcher below picks which.
import embed from '../embeds/ecosystem-map.html?raw';

const months = [...embed.matchAll(/<!-- Techstars Belfast events map · ([A-Za-z]+ \d{4}) ·[^>]*-->\s*<div id="(tsb-ev[-\d]*)"/g)]
    .map(m => ({ label: m[1], id: m[2] }));
---

<BaseLayout title="Ecosystem" description="A monthly map of what is on across the Northern Ireland start-up community: events, accelerators and funding, who is hiring, and news.">
    <section class="hero">
        <div class="wrap wrap--mid">
            <p class="eyebrow">Ecosystem</p>
            <h1>What's on,<br /><span class="accent">across Northern Ireland.</span></h1>
            <p class="lead hero-lead">
                A monthly map of the start-up community: events, accelerators and funding, who is hiring, and the news. Pick a month, then a town, a week or a filter.
            </p>
        </div>
    </section>

    <section class="section--tight divide ecosystem">
        <div class="wrap">
            {months.length > 1 && (
                <div class="month-switch" role="group" aria-label="Choose a month">
                    {months.map(m => <button type="button" data-target={m.id} aria-pressed="false">{m.label}</button>)}
                </div>
            )}
            <Fragment set:html={embed} />
        </div>
    </section>
</BaseLayout>

<script>
    const sw = document.querySelector('.month-switch');
    if (sw) {
        const buttons = [...sw.querySelectorAll('button')];
        const show = (id: string) => {
            buttons.forEach(b => {
                const on = b.dataset.target === id;
                b.setAttribute('aria-pressed', on ? 'true' : 'false');
                const block = document.getElementById(b.dataset.target || '');
                if (block) block.hidden = !on;
            });
        };
        const now = new Date().toLocaleString('en-GB', { month: 'long', year: 'numeric' });
        const current = buttons.find(b => b.textContent?.trim() === now) || buttons[0];
        show(current.dataset.target || '');
        buttons.forEach(b => b.addEventListener('click', () => show(b.dataset.target || '')));
    }
</script>

<style>
    .hero { padding: 5rem 0 3rem; }
    .hero h1 { margin-bottom: 1rem; }
    .accent { color: var(--accent); }
    .hero-lead { max-width: 52ch; }
    .ecosystem { background: #fff; }
    .month-switch { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0 0 1.75rem; }
    .month-switch button {
        font: inherit;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 0.5rem 1.1rem;
        border-radius: 999px;
        border: 1.5px solid var(--line);
        background: #fff;
        color: var(--ink, #0d0d0d);
        cursor: pointer;
    }
    .month-switch button[aria-pressed="true"] { background: #0d0d0d; border-color: #0d0d0d; color: #fff; }
</style>
