---
import BaseLayout from '../layouts/BaseLayout.astro';
// Reads the ecosystem feed that mammoth emits every Friday
// (mammoth/scripts/build_ecosystem_feed.py from data/ecosystem/*.json plus the
// Techstars Belfast and Founder Labs dates in site_events.json). Both files in
// src/data are generated; never hand-edit them. The map outline came from the
// Ecosystem Hub Emma O'Kane built; the pins are drawn here from the feed.
import feed from '../data/ecosystem-feed.json';
import mapBase from '../data/ecosystem-map.svg?raw';

const SUBMIT_EMAIL = 'techstarsbelfast@ormeaulabs.com';

const buildDate = new Date();
const today = new Date(buildDate.getFullYear(), buildDate.getMonth(), buildDate.getDate());
const iso = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const parse = (s) => { const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d); };
const monday = (d) => { const r = new Date(d); r.setDate(d.getDate() - ((d.getDay() + 6) % 7)); return r; };
const longDay = (d) => `${d.getDate()} ${d.toLocaleString('en-GB', { month: 'long' })}`;

const events = feed.events
    .filter(e => parse(e.date) >= today)
    .map(e => {
        const d = parse(e.date);
        return {
            ...e,
            week: iso(monday(d)),
            month: e.date.slice(0, 7),
            dow: d.toLocaleString('en-GB', { weekday: 'short' }).toUpperCase(),
            day: String(d.getDate()).padStart(2, '0'),
            mon: d.toLocaleString('en-GB', { month: 'short' }).toUpperCase(),
        };
    });

const weeks = [...new Set(events.map(e => e.week))].sort();
const months = [...new Set(events.map(e => e.month))].sort()
    .map(m => ({ value: m, label: parse(`${m}-01`).toLocaleString('en-GB', { month: 'long', year: 'numeric' }) }));
const towns = feed.towns;
const pinned = [...new Set(events.map(e => e.town))].filter(t => towns[t]);
const onlineCount = events.filter(e => e.town === 'Online').length;

const PIN_PATH = 'M0 0 C-4 -8 -12 -13 -12 -22 A12 12 0 1 1 12 -22 C12 -13 4 -8 0 0Z';
const pins = pinned.map(t => {
    const { x, y } = towns[t];
    const n = events.filter(e => e.town === t).length;
    // Labels sit to the right except where that would cross the Belfast cluster.
    const anchor = (t === 'Belfast' || t === 'Lisburn') ? 'end' : 'start';
    const lx = anchor === 'end' ? x - 16 : x + 16;
    return `<text class="pinlabel" data-town="${t}" x="${lx}" y="${y - 20}" text-anchor="${anchor}">${t}</text>` +
        `<g class="pin" data-town="${t}" tabindex="0" role="button" aria-label="${t}: ${n} items" transform="translate(${x},${y})">` +
        `<g class="pg"><path d="${PIN_PATH}" fill="#04CF61"/><text x="0" y="-18" text-anchor="middle">${n}</text></g></g>`;
}).join('');
const mapSvg = mapBase.replace(/<\/svg>\s*$/, pins + '</svg>');

const tagLabel = (e) => e.tier === 1 ? (e.org === 'Founder Labs' ? 'Founder Labs' : 'Techstars Belfast') : (e.type === 'funding' ? 'Funding and deadlines' : 'Event');
const where = (e) => [e.org, e.venue].filter(Boolean).join(' · ');

const jobs = feed.jobs;
const news = feed.news;
const updated = parse(feed.generated).toLocaleString('en-GB', { day: 'numeric', month: 'long' });
---

<BaseLayout title="Ecosystem" description="What is on across the Northern Ireland start-up community: events and funding deadlines on a map, who is hiring, and the news. Updated every Friday.">
    <section class="hero">
        <div class="wrap">
            <p class="eyebrow">Ecosystem</p>
            <h1>What's on,<br /><span class="accent">across Northern Ireland.</span></h1>
            <p class="lead hero-lead">
                Events and funding deadlines on the map, who is hiring, and the news from the start-up community. Swept every Friday; last updated {updated}.
            </p>
            <nav class="jump" aria-label="On this page">
                <a href="#whats-on">What's on</a>
                <a href="#hiring">Who's hiring</a>
                <a href="#news">News</a>
            </nav>
        </div>
    </section>

    <section id="whats-on" class="section--tight divide ecosystem">
        <div class="wrap">
            <div class="sec-head">
                <h2>What's on</h2>
                <p class="muted">Pick a month, a town on the map, or a filter. Funding deadlines sit alongside events.</p>
            </div>

            <div class="controls" id="eco">
                <label class="range">
                    <span class="eyebrow">Showing</span>
                    <select aria-label="Choose a period">
                        <option value="next4">Next four weeks</option>
                        {months.map(m => <option value={m.value}>{m.label}</option>)}
                        <option value="all">Everything upcoming</option>
                    </select>
                </label>
                <div class="chips" role="group" aria-label="Filter by type">
                    <button type="button" data-t="all" aria-pressed="true">All</button>
                    <button type="button" data-t="event" aria-pressed="false">Events</button>
                    <button type="button" data-t="funding" aria-pressed="false">Funding and deadlines</button>
                </div>
                <p class="count muted" aria-live="polite"></p>
            </div>

            <div class="grid">
                <div class="map-col">
                    <div class="map" set:html={mapSvg} />
                    <div class="map-foot">
                        {onlineCount > 0 && <button type="button" class="online" data-town="Online" aria-pressed="false">Online <b>{onlineCount}</b></button>}
                        <p class="town-note muted" hidden>Showing <b></b> only. <a href="#whats-on" class="clear">Show every town</a></p>
                    </div>
                </div>

                <div class="list">
                    {weeks.map(w => (
                        <section class="week" data-week={w}>
                            <h3 class="weekhead">Week commencing {longDay(parse(w))}</h3>
                            <div class="cards">
                                {events.filter(e => e.week === w).map(e => (
                                    <article class={`card eco-card ${e.type} ${e.tier === 1 ? 'ours' : ''} ${e.cancelled ? 'cancelled' : ''}`} data-date={e.date} data-month={e.month} data-type={e.type} data-town={e.town}>
                                        <div class="date-box"><span class="dow">{e.dow}</span><span class="day">{e.day}</span><span class="mon">{e.mon}</span></div>
                                        <div class="body">
                                            <div class="tag-row">
                                                <span class={`tag-pill ${e.tier === 1 ? 'ours' : e.type}`}>{tagLabel(e)}</span>
                                                {e.tbc && <span class="tag-pill tbc">Details tbc</span>}
                                                {e.cancelled && <span class="tag-pill tbc">Cancelled</span>}
                                            </div>
                                            <h4>{e.title}</h4>
                                            {where(e) && <p class="where">{where(e)}</p>}
                                            {e.time && <p class="when">{e.time}{e.end && e.end !== e.date ? ` · to ${longDay(parse(e.end))}` : ''}</p>}
                                            {e.note && <p class="muted note">{e.note}</p>}
                                        </div>
                                        {e.url && <a href={e.url} class="btn btn--ghost btn--sm" target="_blank" rel="noopener">Details</a>}
                                    </article>
                                ))}
                            </div>
                        </section>
                    ))}
                    <p class="none muted" hidden>Nothing listed for that choice yet. Try a wider period or clear the town.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="hiring" class="section--tight divide hiring">
        <div class="wrap">
            <div class="sec-head">
                <h2>Who's hiring</h2>
                <p class="muted">Live roles at Northern Ireland start-ups and scale-ups, re-checked monthly. A company stays here while it has something open.</p>
            </div>
            {jobs.length ? (
                <div class="role-grid">
                    {jobs.map(j => (
                        <article class="role">
                            <h3>{j.company}</h3>
                            {j.roles && <p class="roles">{j.roles}</p>}
                            {j.town && <p class="where">{j.town}</p>}
                            {j.note && <p class="muted note">{j.note}</p>}
                            {j.url && <a href={j.url} class="btn btn--sm" target="_blank" rel="noopener">See roles</a>}
                        </article>
                    ))}
                </div>
            ) : (
                <p class="muted">No roles listed right now. The next sweep lands on Friday.</p>
            )}
        </div>
    </section>

    <section id="news" class="section--tight divide newsroom">
        <div class="wrap">
            <div class="sec-head">
                <h2>News</h2>
                <p class="muted">What happened in the ecosystem over the last three months, newest first.</p>
            </div>
            {news.length ? (
                <div class="news-list">
                    {news.map(n => (
                        <article class="news-item">
                            <h3>{n.url ? <a href={n.url} target="_blank" rel="noopener">{n.title}</a> : n.title}</h3>
                            {n.blurb && <p class="muted">{n.blurb}</p>}
                            <p class="src">{[n.source, parse(n.date).toLocaleString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })].filter(Boolean).join(' · ')}</p>
                        </article>
                    ))}
                </div>
            ) : (
                <p class="muted">No news listed right now.</p>
            )}
        </div>
    </section>

    <section class="section--tight divide submit">
        <div class="wrap">
            <p>Listed by the Techstars Belfast community team. Running an event, opening a role, or have news from your company? <a href={`mailto:${SUBMIT_EMAIL}?subject=Ecosystem%20page`}>Send it to us</a> and it goes in the next update.</p>
        </div>
    </section>
</BaseLayout>

<script>
    (function () {
        var root = document.getElementById('whats-on'); if (!root) return;
        var sel = root.querySelector('.range select');
        var chips = root.querySelectorAll('.chips button');
        var cards = root.querySelectorAll('.eco-card');
        var weeks = root.querySelectorAll('.week');
        var pins = root.querySelectorAll('.pin');
        var labels = root.querySelectorAll('.pinlabel');
        var online = root.querySelector('.online');
        var note = root.querySelector('.town-note');
        var none = root.querySelector('.none');
        var count = root.querySelector('.count');
        var type = 'all', town = null;

        function iso(d) { return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
        var now = new Date(), todayIso = iso(now);
        var horizon = new Date(now); horizon.setDate(now.getDate() + 28); var horizonIso = iso(horizon);

        function inRange(c) {
            var v = sel.value, d = c.dataset.date;
            if (v === 'all') return true;
            if (v === 'next4') return d >= todayIso && d <= horizonIso;
            return c.dataset.month === v;
        }
        function scoped(c) { return inRange(c) && (type === 'all' || c.dataset.type === type); }

        function apply() {
            var counts = {}, fund = {}, shown = 0;
            cards.forEach(function (c) {
                var s = scoped(c);
                if (s) { counts[c.dataset.town] = (counts[c.dataset.town] || 0) + 1; if (c.dataset.type === 'funding') fund[c.dataset.town] = (fund[c.dataset.town] || 0) + 1; }
                var vis = s && (!town || c.dataset.town === town);
                c.hidden = !vis; if (vis) shown++;
            });
            if (town && !counts[town]) { town = null; return apply(); }
            weeks.forEach(function (w) { w.hidden = !w.querySelector('.eco-card:not([hidden])'); });
            pins.forEach(function (p) {
                var t = p.dataset.town, n = counts[t] || 0;
                p.style.display = n ? '' : 'none';
                p.querySelector('.pg text').textContent = n;
                p.setAttribute('aria-label', t + ': ' + n + (n === 1 ? ' item' : ' items'));
                p.classList.toggle('sel', t === town);
                p.querySelector('.pg path').setAttribute('fill', n && fund[t] === n ? '#0B0D0C' : '#04CF61');
            });
            labels.forEach(function (l) { l.style.display = counts[l.dataset.town] ? '' : 'none'; });
            if (online) { var on = counts.Online || 0; online.hidden = !on; online.querySelector('b').textContent = on; online.setAttribute('aria-pressed', town === 'Online' ? 'true' : 'false'); }
            chips.forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.t === type ? 'true' : 'false'); });
            note.hidden = !town; note.querySelector('b').textContent = town || '';
            none.hidden = shown > 0;
            count.textContent = shown ? shown + (shown === 1 ? ' listing' : ' listings') : '';
        }
        function toggleTown(t) { town = town === t ? null : t; apply(); }

        root.addEventListener('click', function (e) {
            var p = e.target.closest('.pin'); if (p) { toggleTown(p.dataset.town); return; }
            var b = e.target.closest('.chips button'); if (b) { type = b.dataset.t; apply(); return; }
            if (e.target.closest('.online')) { toggleTown('Online'); return; }
            if (e.target.closest('.clear')) { e.preventDefault(); town = null; apply(); }
        });
        root.addEventListener('keydown', function (e) {
            var p = e.target.closest('.pin');
            if (p && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); toggleTown(p.dataset.town); }
        });
        sel.addEventListener('change', function () { town = null; apply(); });

        function fromHash() {
            var h = (location.hash || '').slice(1);
            if (h === 'events' || h === 'funding') { type = h === 'events' ? 'event' : 'funding'; if (sel.value === 'next4') sel.value = 'all'; apply(); root.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        }
        window.addEventListener('hashchange', fromHash);
        apply(); fromHash();
    })();
</script>

<style>
    .hero { padding: 5rem 0 3rem; }
    .hero h1 { margin-bottom: 1rem; }
    .accent { color: var(--accent); }
    .hero-lead { max-width: 56ch; }
    .jump { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.5rem; }
    .jump a { font-weight: 600; color: var(--accent); border-bottom: 2px solid var(--accent-soft); padding-bottom: 2px; }
    .sec-head { margin-bottom: 1.75rem; }
    .sec-head h2 { margin-bottom: 0.5rem; }
    .sec-head p { max-width: 60ch; }
    .ecosystem { background: #fff; }

    .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-bottom: 1.75rem; }
    .range { display: flex; align-items: center; gap: 0.75rem; }
    .range .eyebrow { margin: 0; }
    .range select { font: inherit; font-weight: 600; padding: 0.55rem 2.2rem 0.55rem 0.9rem; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--ink); }
    .chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .chips button { font: inherit; font-size: 0.9rem; font-weight: 600; padding: 0.5rem 0.95rem; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--ink-soft); cursor: pointer; }
    .chips button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
    .count { margin: 0; font-size: 0.9rem; margin-left: auto; }

    .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
    @media (max-width: 800px) { .grid { grid-template-columns: minmax(0, 1fr); } }
    @media (min-width: 801px) { .map-col { position: sticky; top: 96px; } }
    .map :global(svg) { display: block; width: 100%; height: auto; background: #e6ecea; border-radius: 12px; }
    .map :global(.pin) { cursor: pointer; }
    .map :global(.pin path) { stroke: #fff; stroke-width: 1.6; }
    .map :global(.pin text) { font-size: 11px; font-weight: 700; fill: #0b0d0c; pointer-events: none; font-family: Inter, Arial, sans-serif; }
    .map :global(.pin path[fill='#0B0D0C'] + text) { fill: #fff; }
    .map :global(.pin.sel path) { stroke: #0b0d0c; stroke-width: 2.6; }
    .map :global(.pinlabel) { font-size: 12.5px; font-weight: 700; fill: #0b0d0c; pointer-events: none; font-family: Inter, Arial, sans-serif; }
    .map-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin-top: 0.9rem; }
    .online { font: inherit; font-size: 0.9rem; font-weight: 600; padding: 0.45rem 0.9rem; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--ink-soft); cursor: pointer; }
    .online b { color: var(--accent); margin-left: 0.3rem; }
    .online[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
    .online[aria-pressed='true'] b { color: var(--accent-bright); }
    .town-note { margin: 0; font-size: 0.9rem; }
    .town-note a { color: var(--accent); font-weight: 600; }

    .week { margin-bottom: 2rem; }
    .weekhead { font-family: 'Courier Prime', monospace; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 0.9rem; font-weight: 700; }
    .cards { display: flex; flex-direction: column; gap: 0.9rem; }
    .eco-card { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 1.1rem; align-items: start; padding: 1.25rem; border-radius: 14px; }
    .eco-card:hover { transform: none; }
    .eco-card.cancelled h4 { text-decoration: line-through; color: var(--ink-muted); }
    .date-box { display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--bg-subtle); border-radius: 10px; padding: 0.6rem 0.25rem; line-height: 1.05; }
    .date-box .dow, .date-box .mon { font-family: 'Courier Prime', monospace; font-size: 0.7rem; letter-spacing: 0.08em; color: var(--ink-muted); font-weight: 700; }
    .date-box .day { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.03em; margin: 0.15rem 0; }
    .funding .date-box { background: var(--accent-soft); }
    .ours .date-box { background: var(--ink); }
    .ours .date-box .day { color: #fff; }
    .ours .date-box .dow, .ours .date-box .mon { color: #c9c9c2; }
    .body h4 { font-size: 1.1rem; margin: 0.35rem 0 0.3rem; line-height: 1.25; }
    .body p { margin: 0 0 0.25rem; font-size: 0.93rem; }
    .body .where { color: var(--ink-soft); }
    .body .when { color: var(--accent); font-weight: 600; }
    .body .note { font-size: 0.9rem; margin-top: 0.35rem; }
    .tag-row { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .tag-pill { font-family: 'Courier Prime', monospace; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.25rem 0.55rem; border-radius: 999px; background: var(--bg-subtle); color: var(--ink-soft); font-weight: 700; }
    .tag-pill.funding { background: var(--accent-soft); color: var(--accent); }
    .tag-pill.ours { background: var(--ink); color: var(--accent-bright); }
    .tag-pill.tbc { background: #fff3e0; color: #9a5b00; }
    .eco-card .btn { align-self: center; white-space: nowrap; }
    @media (max-width: 560px) {
        .eco-card { grid-template-columns: 56px minmax(0, 1fr); }
        .eco-card .btn { grid-column: 2; justify-self: start; }
    }
    .none { margin: 1rem 0; }

    .hiring { background: var(--bg-subtle); }
    .role-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
    .role { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .role h3 { margin: 0; font-size: 1.2rem; }
    .role .roles { margin: 0; font-weight: 500; }
    .role .where { margin: 0; font-size: 0.9rem; color: var(--accent); font-weight: 600; }
    .role .note { margin: 0; font-size: 0.95rem; flex: 1; }
    .role .btn { align-self: flex-start; margin-top: 0.5rem; }
    .newsroom { background: #fff; }
    .news-list { display: flex; flex-direction: column; }
    .news-item { padding: 1.4rem 0; border-top: 1px solid var(--line); }
    .news-item:last-child { border-bottom: 1px solid var(--line); }
    .news-item h3 { margin: 0 0 0.4rem; font-size: 1.15rem; }
    .news-item h3 a { color: inherit; }
    .news-item h3 a:hover { color: var(--accent); }
    .news-item p { margin: 0 0 0.4rem; max-width: 70ch; }
    .news-item .src { font-size: 0.85rem; color: #6b6b66; margin: 0; }
    .submit { background: var(--bg-subtle); }
    .submit p { max-width: 70ch; margin: 0; }
    .submit a { font-weight: 600; color: var(--accent); }
</style>
